 static status_t ppp_process_data(sstp_pppd_st *ctx);
+
+/* Log only protocol milestones. PPP authentication packets can contain secrets. */
+static void ppp_log_negotiation(sstp_pppd_st *ctx, const uint8_t *data, int len, bool received)
+{
+    static const char *const configuration[] = {
+        NULL, "Configure-Request", "Configure-Ack", "Configure-Nak", "Configure-Reject",
+        "Terminate-Request", "Terminate-Ack", "Code-Reject", "Protocol-Reject",
+    };
+    static const char *const authentication[] = {
+        NULL, "Challenge", "Response", "Success", "Failure",
+    };
+    static const char *const pap[] = { NULL, "Request", "Ack", "Nak" };
+    const char *protocol;
+    const char *message;
+    unsigned int bit;
+    uint16_t code;
+
+    if (len >= 2 && data[0] == 0xff && data[1] == 0x03)
+    {
+        data += 2;
+        len -= 2;
+    }
+    if (len < 6)
+        return;
+
+    code = ((uint16_t)data[0] << 8) | data[1];
+    unsigned int type = data[2];
+    unsigned int length = ((unsigned int)data[4] << 8) | data[5];
+    if (!type || length < 4 || length > (unsigned int)len - 2)
+        return;
+
+    switch (code)
+    {
+        case 0xc021: /* LCP */
+            if (type >= sizeof(configuration) / sizeof(configuration[0]))
+                return;
+            protocol = "LCP";
+            message = configuration[type];
+            bit = type - 1;
+            break;
+        case 0xc223: /* CHAP */
+            if (type >= sizeof(authentication) / sizeof(authentication[0]))
+                return;
+            protocol = "CHAP";
+            message = authentication[type];
+            bit = 8 + type - 1;
+            break;
+        case PPP_PROTO_PAP:
+            if (type >= sizeof(pap) / sizeof(pap[0]))
+                return;
+            protocol = "PAP";
+            message = pap[type];
+            bit = 18 + type - 1;
+            break;
+        case 0x8021: /* IPCP */
+            if (type > 6)
+                return;
+            protocol = "IPCP";
+            message = configuration[type];
+            bit = 12 + type - 1;
+            break;
+        default:
+            return;
+    }
+
+    uint32_t mask = (uint32_t)1 << bit;
+    unsigned int direction = received ? 0 : 1;
+    if (ctx->logged[direction] & mask)
+        return;
+    ctx->logged[direction] |= mask;
+    log_info("PPP %s %s %s", received ? "server -> client" : "client -> server", protocol, message);
+}
 
 
